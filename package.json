  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:kiosk": "npx playwright test --project=kiosk",
    "test:pos": "npx playwright test --project=pos-dashboard",
    "test:report": "npx playwright show-report tests/e2e/report",
    "vr:baseline": "npx playwright test --config tests/visual-regression/playwright.config.ts --update-snapshots",
    "vr:compare": "npx playwright test --config tests/visual-regression/playwright.config.ts",
    "vr:before-after": "bash scripts/visual-regression.sh before-after"
  },
