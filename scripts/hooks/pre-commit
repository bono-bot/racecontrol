#!/usr/bin/env bash
# pre-commit-hook.sh — Blocks commits that introduce security regressions.
#
# SEC-GATE-02: Pre-commit credential leak and security pattern scanner.
# Installed in .git/hooks/pre-commit for both comms-link and racecontrol repos.
#
# What it checks (on STAGED files only — fast, incremental):
#   1. Hardcoded credentials (passwords, API keys, private keys, AWS keys)
#   2. Sensitive config files that shouldn't be committed (.env, racecontrol.toml)
#   3. Dangerous code patterns (shell=true, .unwrap() in Rust, 'any' in TypeScript)
#
# Exit 0 = commit allowed. Non-zero = commit blocked.

set -e

RED=$(printf '\033[0;31m')
GREEN=$(printf '\033[0;32m')
YELLOW=$(printf '\033[0;33m')
RESET=$(printf '\033[0m')

FAILURES=0

fail() {
  echo "${RED}BLOCKED${RESET}: $1"
  FAILURES=$((FAILURES + 1))
}

warn() {
  echo "${YELLOW}WARNING${RESET}: $1"
}

pass() {
  echo "${GREEN}OK${RESET}: $1"
}

# ---------------------------------------------------------------------------
# Branch awareness: surface current branch before any staged-file logic so
# scope-contamination (e.g. committing unrelated housekeeping onto an active
# PR branch) is visible at commit time. Non-blocking — informational only.
# Fires even for --allow-empty and on staged-nothing commits.
# ---------------------------------------------------------------------------
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "(detached)")
BRANCH_UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null || echo "")

if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
  echo "Branch: ${GREEN}${CURRENT_BRANCH}${RESET}"
elif [ -n "$BRANCH_UPSTREAM" ]; then
  echo "Branch: ${YELLOW}${CURRENT_BRANCH}${RESET} (upstream: ${BRANCH_UPSTREAM}) — shared; verify commit scope matches branch intent"
else
  echo "Branch: ${GREEN}${CURRENT_BRANCH}${RESET} (local-only — no upstream yet)"
fi
echo ""

# Get staged files (only added/modified, not deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Security pre-commit check (SEC-GATE-02)..."
echo ""

# ---------------------------------------------------------------------------
# Check 1: Credential patterns in staged content
# ---------------------------------------------------------------------------

# Get the staged diff content (what will actually be committed)
STAGED_DIFF=$(git diff --cached --unified=0 2>/dev/null)

# Patterns that should NEVER appear in committed code
# Check added lines only (lines starting with +, not ++)
ADDED_LINES=$(echo "$STAGED_DIFF" | grep '^+' | grep -v '^+++' || true)

# Private keys (exclude regex patterns, test commands, grep patterns, and echo examples)
if echo "$ADDED_LINES" | grep -v 'pattern' | grep -v 'test(' | grep -v 'assert' | grep -v 'RegExp' | grep -v 'grep' | grep -v 'echo ' | grep -v '#' | grep -q -- '-----BEGIN.*PRIVATE KEY-----'; then
  fail "Private key detected in staged changes"
fi

# AWS access keys
if echo "$ADDED_LINES" | grep -qE 'AKIA[0-9A-Z]{16}'; then
  fail "AWS access key pattern detected in staged changes"
fi

# Hardcoded passwords (not in comments, not env var reads)
if echo "$ADDED_LINES" | grep -v '^\+\s*//' | grep -v 'process\.env\.' | grep -v 'env::var' | grep -v 'getenv' | grep -qiE '(password|passwd)\s*[:=]\s*"[^"]{8,}"'; then
  # Filter out test files and config templates
  PASS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(test|spec)\.' || true)
  if [ -z "$PASS_FILES" ]; then
    fail "Hardcoded password detected in staged changes (not in test file)"
  fi
fi

# Check for the known-bad default JWT secret in non-config files
if echo "$ADDED_LINES" | grep -v 'main\.rs' | grep -q 'racingpoint-jwt-change-me-in-production'; then
  warn "Default JWT secret string found — ensure this is only in the startup warning check"
fi

if [ $FAILURES -eq 0 ]; then
  pass "No credential leaks in staged changes"
fi

# ---------------------------------------------------------------------------
# Check 2: Sensitive files that shouldn't be committed
# ---------------------------------------------------------------------------

SENSITIVE_PATTERNS=(
  ".env.local"
  ".env.production.local"
  "racecontrol.toml"
  "racecontrol.docker.toml"
  "credentials.json"
  "token.json"
  "id_rsa"
  "id_ed25519"
  ".pem"
)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
  MATCHED=$(echo "$STAGED_FILES" | grep "$pattern" || true)
  if [ -n "$MATCHED" ]; then
    fail "Sensitive file staged for commit: $MATCHED"
  fi
done

if [ $FAILURES -eq 0 ]; then
  pass "No sensitive files in staged changes"
fi

# ---------------------------------------------------------------------------
# Check 3: Dangerous code patterns (Rust + TypeScript + JavaScript)
# ---------------------------------------------------------------------------

# .unwrap() in production Rust (not in tests)
RUST_STAGED=$(echo "$STAGED_FILES" | grep '\.rs$' | grep -v 'test' | grep -v 'build.rs' || true)
if [ -n "$RUST_STAGED" ]; then
  for file in $RUST_STAGED; do
    # Check only the added lines in this file
    FILE_ADDS=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++' || true)
    UNWRAP_COUNT=$(echo "$FILE_ADDS" | grep -c '\.unwrap()' || true)
    if [ "$UNWRAP_COUNT" -gt 0 ]; then
      warn ".unwrap() found in $file ($UNWRAP_COUNT occurrences) — use ? or .ok() in production"
    fi
  done
fi

# 'any' type in TypeScript (not in tests, not in comments)
TS_STAGED=$(echo "$STAGED_FILES" | grep '\.tsx\?$' | grep -v 'test' | grep -v '.d.ts' || true)
if [ -n "$TS_STAGED" ]; then
  for file in $TS_STAGED; do
    FILE_ADDS=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++' || true)
    # Match ': any' or '<any>' but not in comments
    ANY_COUNT=$(echo "$FILE_ADDS" | grep -v '^\+\s*//' | grep -cE ':\s*any\b|<any>' || true)
    if [ "$ANY_COUNT" -gt 0 ]; then
      warn "'any' type found in $file ($ANY_COUNT occurrences) — type explicitly"
    fi
  done
fi

# ---------------------------------------------------------------------------
# Check 4: Workflow-plan cascade (Day 3 gate)
# ---------------------------------------------------------------------------
# Runs the Day 2 orchestrator (board-state-generate + dpdp-coverage-check +
# future types/protocol/http/fleet checkers) to block commits that introduce
# board-state coverage regressions. Uses save/restore on the two working-tree
# artifacts the orchestrator rewrites (.planning/board-state.json +
# .planning/board-state/status.json), so the hook leaves no residue in the
# working tree regardless of outcome.
#
# This is the specific regression that would have blocked 4ab2e835 (22-table
# DPDP rewrite missing 18 FK edges + 2 pointer entries + 1 transitive clear)
# and later 1257a1b5-era gaps (personal_bests_v2 / track_records_v2 + 3 lap
# ordering bugs + 2 transitive-to-parent holes).

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
ORCHESTRATOR="$REPO_ROOT/scripts/audit/run-all-checkers.sh"
BOARD_STATE_JSON="$REPO_ROOT/.planning/board-state.json"
BOARD_STATE_STATUS="$REPO_ROOT/.planning/board-state/status.json"

if [ -n "$REPO_ROOT" ] && [ -x "$ORCHESTRATOR" ] && [ -z "${WORKFLOW_CASCADE_SKIP:-}" ]; then
  echo ""
  echo "Workflow-plan cascade (Day 3 pre-commit gate)..."

  SAVED_BOARD="$(mktemp -t wf-pc-board.XXXXXX)"
  SAVED_STATUS="$(mktemp -t wf-pc-status.XXXXXX)"
  # EXIT trap cleans up tmpfiles whether we fail, succeed, or crash mid-check.
  trap 'rm -f "$SAVED_BOARD" "$SAVED_STATUS"' EXIT

  [ -f "$BOARD_STATE_JSON"   ] && cp "$BOARD_STATE_JSON"   "$SAVED_BOARD"
  [ -f "$BOARD_STATE_STATUS" ] && cp "$BOARD_STATE_STATUS" "$SAVED_STATUS"

  # Orchestrator exits 1 on red / 2 on generator_error, which 'set -e' would
  # treat as hook failure. Disable -e around the call, capture exit explicitly.
  set +e
  CASCADE_OUT="$(bash "$ORCHESTRATOR" 2>&1)"
  CASCADE_EXIT=$?
  set -e

  # Restore saved artifacts — pre-commit hook is NOT allowed to dirty the tree.
  # (Writes would appear as unstaged diffs the next time the user runs git status.)
  [ -s "$SAVED_BOARD"  ] && cp "$SAVED_BOARD"  "$BOARD_STATE_JSON"
  [ -s "$SAVED_STATUS" ] && cp "$SAVED_STATUS" "$BOARD_STATE_STATUS"

  # Surface just the summary line (one-line workflow-check ... line from orchestrator).
  echo "$CASCADE_OUT" | grep '^workflow-check ' || echo "(orchestrator produced no summary line — see full output below)"

  case "$CASCADE_EXIT" in
    0) pass "Workflow-plan cascade all-green" ;;
    1)
      fail "Workflow-plan cascade RED — at least one checker found a gap"
      echo "    Full diagnostic: bash scripts/audit/run-all-checkers.sh"
      echo "    Details:        cat .planning/board-state/status.json"
      echo "    Bypass (only if you understand the consequence): WORKFLOW_CASCADE_SKIP=1 git commit ..."
      ;;
    2)
      fail "Workflow-plan cascade GENERATOR_ERROR — source unparseable"
      echo "    Full output (trimmed):"
      echo "$CASCADE_OUT" | tail -20 | sed 's/^/    /'
      ;;
    *)
      fail "Workflow-plan cascade exited unexpectedly with code $CASCADE_EXIT"
      echo "$CASCADE_OUT" | tail -10 | sed 's/^/    /'
      ;;
  esac
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------

echo ""
if [ $FAILURES -gt 0 ]; then
  echo "${RED}Pre-commit check FAILED${RESET} ($FAILURES issue(s) found)"
  echo "Fix the issues above or use --no-verify to bypass (NOT recommended)."
  exit 1
fi
echo "${GREEN}Pre-commit check passed${RESET}"
# NOTE: no `exit 0` here — scripts/install-git-hooks.sh appends a smart-pipes
# security-scan invocation after this line, and its exit code becomes the
# hook's exit code. Adding `exit 0` would make that appendix unreachable.
